{
  "id": "amn_hudlyrics",
  "title": "TJM HUD Lyrics",
  "description": "Synced lyrics for the song playing over CarPlay (Apple Music, Spotify...), one line at a time in the head-up display, and in Sport, Sport+ and Sport Individual a rev tach in their place: Redline's Ramp layout (after the G80/G82 M3 and M4's HUD), with the shift lights, gear, D / S / M and the readouts you pick (oil, gearbox and water temperatures, and the cold-engine rev limit, which also brings the shift lights down while the oil is cold); back to the lyrics in Comfort, Eco Pro and Adaptive. The centre screen shows the song, the lyrics as they are sung, and a status row that says what each part is doing. It starts with the car and runs in the background. The lyrics on the HUD are experimental and off until you switch them on in Settings; they hide during route guidance and when a song has no synced lyrics. Read-only toward the car (the gearbox temperature is read from the gearbox unit with read-only diagnostic requests, as Redline does). Lyrics from LRCLIB (lrclib.net), its only internet host, through the Store's uplink. Needs the Cluster renderer tool from the Store.",
  "version": "0.7.0",
  "vendor": "TJM",
  "mguAppStartType": "autostart",
  "loggingId": "OB2F",
  "internet": true,
  "signals": {
    "de.bmw.infotainment.a4a.carplay.CarPlayManager": "*",
    "de.bmw.infotainment.entertainment.mediaplayer.MediaPlayer": "*",
    "de.bmw.infotainment.hmi.hmimediastate.HmiMediaState": "*",
    "de.bmw.infotainment.entertainment.dynamicmediaplayer.DynamicMediaPlayer": "*",
    "de.bmw.infotainment.navigation.navigationstatus.NavigationStatus": {
      "_optional": "the HUD's route guidance check (BMW navigation): guidingState ACTIVE hides the lyrics",
      "guidingState": "rs"
    },
    "de.bmw.infotainment.sdi.aap.androidautoprojectedmanager.AndroidAutoProjectedManager": {
      "_optional": "the HUD's route guidance check (Android Auto): projectedGuidanceActive",
      "_instances": "AndroidAutoProjectedManagerInst1",
      "projectedGuidanceActive": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "_optional": "the Sport HUD: rpm, oil and water",
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_optional": "the Sport HUD: the gear and the selector",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "_optional": "the Sport HUD: the gearbox programme (D / S / M)",
      "dataDisplayGearbox": "s"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "the drive mode: Sport shows the tach on the HUD",
      "statusFESVehicleDynamicSwitchHMI": "rs"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "_optional": "the Sport HUD: gearbox oil temperature when the gearbox unit doesn't answer",
      "basicDataSet": "s"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_optional": "the Sport HUD: gearbox oil temperature from the gearbox unit (read-only UDS 22, kit/readonly-diag.js)",
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    }
  },
  "screens": [

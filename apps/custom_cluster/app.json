{
  "id": "custom_cluster",
  "title": "TJM Custom Cluster",
  "description": "G80, G21 and classic 6WB digital cluster styles, map-safe RGB themes, shared Waze renderer and iPhone bridge",
  "version": "0.5.5",
  "vendor": "TJM",
  "loggingId": "OB1E",
  "iconGlyph": "CC",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "TJM Custom Cluster",
      "buttons": [
        [
          "BTN_TEST",
          "Parked panel test"
        ],
        [
          "BTN_DIAG",
          "Diagnostics"
        ],
        [
          "BTN_QR",
          "QR logs"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    },
    {
      "name": "DIAGNOSTICS",
      "kind": "canvas",
      "title": "Custom Cluster - Diagnostics",
      "buttons": [
        [
          "BTN_DIAG_REFRESH",
          "Refresh"
        ],
        [
          "BTN_DIAG_QR",
          "QR report"
        ],
        [
          "BTN_DIAG_HOME",
          "Back to cluster"
        ]
      ]
    },
    {
      "name": "QR_REPORT",
      "kind": "canvas",
      "title": "Custom Cluster - QR report",
      "buttons": [
        [
          "BTN_QR_NEXT",
          "Next QR page"
        ],
        [
          "BTN_QR_NEW",
          "New report"
        ],
        [
          "BTN_QR_HOME",
          "Back to cluster"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "layout",
      "label": "Cluster layout",
      "type": "choice",
      "default": "stock",
      "options": [
        [
          "stock",
          "BMW original (unchanged)"
        ],
        [
          "sixwb",
          "BMW 6WB digital (parked test)"
        ],
        [
          "oem",
          "G21 OEM-style recolor (parked test)"
        ],
        [
          "g80",
          "G80 full cluster (parked test)"
        ],
        [
          "sport",
          "M Sport"
        ],
        [
          "classic",
          "Classic dials"
        ],
        [
          "minimal",
          "Minimal digital"
        ]
      ]
    },
    {
      "key": "wazeMap",
      "label": "Waze map in cluster",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Keep Waze's own setting"
        ],
        [
          "on",
          "Show Waze map"
        ],
        [
          "off",
          "Hide Waze map"
        ]
      ]
    },
    {
      "key": "panelTestMode",
      "label": "Parked test content",
      "type": "choice",
      "default": "probe",
      "options": [
        [
          "probe",
          "Small diagnostic marker (recommended)"
        ],
        [
          "design",
          "Selected full cluster design (experimental)"
        ]
      ]
    },
    {
      "key": "panelTarget",
      "label": "Panel target / slot",
      "type": "choice",
      "default": "panel",
      "options": [
        [
          "panel",
          "Standard panel (0x203)"
        ],
        [
          "panel201",
          "Experimental 0x201 (requires renderer support)"
        ],
        [
          "panel202",
          "Experimental 0x202 (requires renderer support)"
        ]
      ]
    },
    {
      "key": "sixwbTheme",
      "label": "6WB driving display",
      "group": "6WB",
      "type": "choice",
      "default": "comfort",
      "when": {
        "layout": "sixwb"
      },
      "options": [
        [
          "comfort",
          "Comfort (white)"
        ],
        [
          "sport",
          "Sport (red)"
        ],
        [
          "eco",
          "ECO PRO (blue)"
        ]
      ]
    },
    {

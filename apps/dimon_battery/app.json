  "config": {
    "comment": "The 12 V battery is read with UDS ReadDataByIdentifier (0x22) from the battery sensor / engine unit. Each value tries its candidates in order and keeps the first that answers with a plausible number: value = raw * factor + offset, raw = 'bytes' big-endian bytes from 'at'. 'ecu' is decimal (18 = DME engine unit, 7 = SME, 24 = EGS). DIDs differ between models; adjust here if a value shows n/a. v12 is F442, the standard OBD 'control module voltage' (terminal 30 = the 12 V battery). Current, SOC, SOH and temperature come from the intelligent battery sensor (IBS) via the engine unit; IBS current is negative when discharging. These identifiers match the ones Live Data and eDrive use.",
    "ecu": 18,
    "pollMs": 4000,
    "v12": [
      {
        "ecu": 18,
        "did": "F442",
        "bytes": 2,
        "at": 0,
        "factor": 0.001,
        "offset": 0,
        "min": 5,
        "max": 18
      },
      {
        "ecu": 7,
        "did": "F442",
        "bytes": 2,
        "at": 0,
        "factor": 0.001,
        "offset": 0,
        "min": 5,
        "max": 18
      },
      {
        "ecu": 18,
        "obd": "42",
        "bytes": 2,
        "at": 0,
        "factor": 0.001,
        "offset": 0,
        "min": 5,
        "max": 18,
        "note": "the same PID with OBD service 01, for engine units that refuse F442 with NRC 31"
      },
      {
        "ecu": 24,
        "did": "F442",
        "bytes": 2,
        "at": 0,
        "factor": 0.001,
        "offset": 0,
        "min": 5,
        "max": 18,
        "note": "transmission unit EGS (0x18), when the engine unit does not answer"
      }
    ],
    "i12": [
      {
        "ecu": 18,
        "did": "5852",
        "bytes": 2,
        "factor": 0.02,
        "offset": -200,
        "min": -200,
        "max": 200,
        "note": "12 V battery current from the IBS, negative = discharging"
      }
    ],
    "soc12": [
      {
        "ecu": 18,
        "did": "56F0",
        "bytes": 1,
        "signed": true,
        "min": 1,
        "max": 100
      }
    ],
    "soh12": [
      {
        "ecu": 18,
        "did": "59AA",
        "bytes": 1,
        "signed": true,
        "min": 1,
        "max": 100
      }
    ],
    "t12": [
      {
        "ecu": 18,
        "did": "5854",
        "bytes": 1,
        "factor": 0.75,
        "offset": -48,
        "min": -40,
        "max": 90
      }
    ]
  }
}

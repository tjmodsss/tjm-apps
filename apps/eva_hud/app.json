{
  "id": "eva_hud",
  "title": "TJM EVA HUD",
  "description": "NERV battle display on the windshield HUD and the instrument cluster: giant gear, rev bar, speed and full-screen title-card alerts",
  "version": "0.5.3",
  "vendor": "TJM",
  "loggingId": "OB21",
  "iconGlyph": "EVA",
  "credits": {
    "title": "EVA HUD APP",
    "text": "Free and open source by DukeAPenguin, based on Bimmer-Lab and idrive-apps"
  },

{
  "id": "front_camera_cluster",
  "title": "TJM Night Vision Cluster",
  "description": "Full-screen control for BMW Night Vision and parking-camera projection in the instrument cluster",
  "version": "0.2.1",
  "vendor": "TJM",
  "loggingId": "OB14",
  "iconGlyph": "NVC",
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    }

      "buttons": [
        [
          "BTN_NIGHT",
          "Night Vision"
        ],
        [
          "BTN_PARK",
          "Parking camera"
        ],
        [
          "BTN_STOP",
          "Stop"
        ],
        [
          "BTN_REFRESH",
          "Refresh status"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "reset": 2,
      "options": [
        [
          "full",
          "Full screen"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "reset": 2,
      "options": [
        [
          "auto",
          "GPU 60 fps"
        ]
      ]
    }
  ],

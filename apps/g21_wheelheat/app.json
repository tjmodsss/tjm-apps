{
  "id": "g21_wheelheat",
  "title": "TJM Heating Comfort",
  "description": "Ignition-aware cold-weather heating with manual stop, durable parking lockout and launch logs",
  "version": "0.4.16",
  "mguAppStartType": "autostart",
  "vendor": "TJM",
  "loggingId": "OB1B",
  "iconGlyph": "LHZ",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "_optional": "Ignition and vehicle-off monitoring; fail closed if unavailable",
      "VehicleCondition": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Heating Comfort",
      "buttons": [
        [
          "BTN_PAGE",
          "Next tab"
        ],
        [
          "BTN_ACTION",
          "Read BDC status / Next QR page"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ],
        [
          "BTN_STOP",
          "STOP automatic heating"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "autoEnabled",
      "label": "Automatic heating on cold startup",
      "type": "bool",
      "default": false
    },
    {
      "key": "belowTemp",
      "label": "Start at or below",
      "type": "number",
      "unit": "°C",
      "default": 8,
      "steps": [
        -10,
        -5,
        0,
        2,
        5,
        8,
        10,
        12,
        15,
        18,
        20
      ]
    },
    {
      "key": "minVehicleOffMins",
      "label": "Minimum vehicle OFF time before next auto start",
      "type": "number",
      "unit": "min",
      "default": 30,
      "steps": [
        0,
        10,
        15,
        20,
        30,
        45,
        60,
        90
      ]
    },
    {
      "key": "testNextStartup",
      "label": "Test next ignition ON (skip parking time once)",
      "type": "bool",
      "default": false
    },
    {
      "key": "wheelAuto",
      "label": "Steering wheel heating",
      "type": "bool",
      "default": true
    },
    {
      "key": "wheelMins",
      "label": "Steering wheel duration",
      "type": "number",
      "unit": "min",
      "default": 3,
      "steps": [
        1,
        2,
        3,
        4,
        5,
        6,
        8,
        10,
        12,
        15,
        20
      ]
    },
    {
      "key": "seatDriver",
      "label": "Driver seat heating",
      "type": "bool",
      "default": true
    },
    {
      "key": "seatPassenger",
      "label": "Passenger seat heating",
      "type": "bool",
      "default": false
    },
    {
      "key": "seatLevel",
      "label": "Seat heating level",
      "type": "number",
      "default": 3,
      "steps": [
        1,
        2,
        3
      ]
    },
    {
      "key": "seatMins",
      "label": "Seat heating duration",
      "type": "number",
      "unit": "min",
      "default": 4,
      "steps": [
        1,
        2,
        3,
        4,
        5,
        6,
        8,
        10,
        12,
        15,
        20
      ]
    }
  ]
}

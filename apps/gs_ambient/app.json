{
  "id": "gs_ambient",
  "title": "TJM Ambient Colour Wheel",
  "description": "Farbrad für die Ambientebeleuchtung: zwei Zonen (oben und unten), Helligkeit, Farbverlauf, Favoritenlauf, Überblenden, Atmen und Favoritengruppen. Standard ist die Simulation. BDC-Licht schreibt über den bestätigten Kurzzeit-Weg und ein Comfort-Dienst hält die Farbe, nachdem die Oberfläche zu ist, bis das Auto aus ist",
  "version": "0.1.8",
  "startType": "autostart",
  "vendor": "TJM",
  "loggingId": "OB2E",
  "iconGlyph": "Am",
  "signals": {

{
  "id": "hotspot_studio",
  "title": "TJM Hotspot Studio",
  "description": "Provides Huawei Internet proxies on BMW's hotspot and opens a timed single-client ENET relay on request",
  "version": "0.1.5",
  "vendor": "TJM",
  "loggingId": "OB13",
  "iconGlyph": "NET",
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_instances": "1",
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_instances": "1",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "TJM Hotspot Studio",
      "buttons": [
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_ACTION",
          "Primary action"
        ],
        [
          "BTN_CLIENT",
          "Next client"
        ],
        [
          "BTN_REFRESH",
          "Refresh"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "codingMinutes",
      "label": "Coding Gateway timeout",
      "type": "choice",
      "default": "20",
      "options": [
        [
          "10",
          "10 minutes"
        ],
        [
          "20",
          "20 minutes"
        ],
        [
          "30",
          "30 minutes"
        ],
        [
          "60",
          "60 minutes"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "reset": 2,
      "options": [
        [
          "full",
          "Full screen"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "reset": 2,
      "options": [
        [
          "auto",
          "GPU 60 fps"
        ]
      ]
    }
  ],
  "config": {
    "fullScreenRequired": true,
    "socket": "/run/hotspot-studio/control.sock"
  }
}

{
  "schemaVersion": 2,
  "name": "Boost",
  "_about": "Boost HUD, generated by design/gen_hud.py: a boost arc (0..1.6 bar) with a dot holding the peak for 4 s, the boost in figures inside it and the peak since the last 0-60 run under it; the gear on the left. Off with Show boost off. Fitted (Nov 9 2026) to the HUD as BMW's own height-adjust frame shows it, x 120..680, y 100..380, and kept clear of the bottom-left x 120..350, y 235..380, where BMW draws its speed and speed-limit sign (and in Sport its rev band) over ours. To change it, copy this file into the app data folder layouts/ (scripts/deploy.sh); the app reloads it by itself. Widget types and tokens: see the header of hud.js.",
  "widgets": [
    {
      "id": "boost_arc",
      "type": "arc",
      "x": 420,
      "y": 110,
      "w": 240,
      "h": 240,
      "signal": "boost",
      "min": 0,
      "max": 1.6,
      "width": 13,
      "peak": 4000,
      "toggle": "showBoost",
      "class": "overlay",
      "z": 10
    },
    {
      "id": "boost",
      "type": "text",
      "z": 10,
      "x": 475,
      "y": 206,
      "w": 130,
      "h": 33,
      "text": "{{boost}}",
      "font": "big",
      "color": "fg",
      "align": "center",
      "toggle": "showBoost",
      "class": "overlay"
    },
    {
      "id": "boost_unit",
      "type": "text",
      "z": 10,
      "x": 500,
      "y": 246,
      "w": 80,
      "h": 20,
      "text": "{{u:boost}}",
      "font": "label",
      "color": "dim",
      "align": "center",
      "toggle": "showBoost",
      "class": "overlay"
    },
    {
      "id": "peak",
      "type": "text",
      "z": 10,
      "x": 465,
      "y": 314,
      "w": 150,
      "h": 17,
      "text": "PEAK {{boostPeak}}",
      "font": "small",
      "color": "dim",
      "align": "center",
      "spacing": 1,
      "toggle": "showBoost",
      "class": "overlay"
    },
    {
      "id": "title",
      "type": "text",
      "z": 10,
      "x": 140,
      "y": 120,
      "w": 120,
      "h": 17,
      "text": "BOOST",
      "font": "small",
      "color": "dim",
      "align": "left",
      "spacing": 1.5,
      "class": "overlay"
    },
    {
      "id": "gear",
      "type": "text",
      "z": 10,
      "x": 140,
      "y": 168,
      "w": 90,
      "h": 33,
      "text": "{{gear}}",
      "font": "big",
      "color": "fg",
      "align": "left",
      "hotWhen": "now",
      "glow": true,
      "class": "overlay"
    }
  ]
}

{
  "id": "jap_sysmon",
  "title": "TJM iDrive Monitor",
  "description": "The head unit's CPU, memory and graphics load, and a short pop-up when the iDrive runs short of them (CPU busy for 30 s, little free memory, apps near their memory cap). Starts with the head unit; no pop-up in reverse.",
  "version": "1.0.7",
  "license": "MIT",
  "vendor": "TJM",
  "loggingId": "OB16",
  "iconGlyph": "gauge",
  "startType": "autostart",
  "signals": {
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "TJM iDrive Monitor",
      "buttons": [
        [
          "BTN_TEST",
          "Test pop-up"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "popups": [
    {
      "name": "SYS_POP",
      "type": "popUp",
      "widget": "LT_State_PopupSmall",
      "label": "text3",
      "button": "OK"
    }
  ],
  "settings": [
    {
      "key": "alerts",
      "label": "Pop-up when the iDrive is short of resources",
      "type": "bool",
      "default": true
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    }
  ]
}

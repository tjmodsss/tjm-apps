        ],
        [
          "BTN_PATTERN",
          "Next pattern"
        ],
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_BACK",
          "Give lamps back"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],

{
  "id": "mdev_homeassistant",
  "title": "TJM Home Assistant",
  "description": "See and switch your home from the car, and send the car's data to Home Assistant. Read only until you allow control.",
  "version": "0.1.0",
  "vendor": "TJM",
  "loggingId": "OB2D",
  "iconGlyph": "HA",
  "internet": true,
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "TJM Home Assistant",
      "buttons": [
        [
          "BTN_RELOAD",
          "Reload"
        ],
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "sendToHA",
      "label": "Send car data to Home Assistant",
      "type": "bool",
      "default": false
    },
    {
      "key": "sendEvery",
      "label": "Send every",
      "type": "number",
      "unit": "s",
      "default": 30,
      "steps": [
        5,
        10,
        30,
        60
      ]
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    },
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Auto"
        ],
        [
          "on",
          "Always"
        ],
        [
          "off",
          "Never"
        ]
      ]
    }
  ]
}

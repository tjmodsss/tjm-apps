{
  "id": "osa",
  "title": "TJM Oil Service",
  "description": "Engine, coolant and transmission oil temperature monitoring with live warm-up estimates and locally stored service history",
  "version": "0.2.22",
  "settingsBeforeLast": true,
  "vendor": "TJM",
  "loggingId": "OB04",
  "iconGlyph": "temp",
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "TJM Oil Service",
      "buttons": [
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_PREV",
          "Previous page"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "full",
          "Full screen"
        ],
        [
          "standard",
          "Standard"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Auto"
        ],
        [
          "software",
          "Software"
        ]
      ]
    },
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Auto"
        ],
        [
          "on",
          "Always"
        ],
        [
          "off",
          "Never"
        ]
      ]
    },
    {
      "key": "warmOil",
      "label": "Oil is warm at",
      "type": "number",
      "unit": "°C",
      "default": 80,
      "steps": [
        60,
        70,
        75,
        80,
        85,
        90,
        100
      ]
    },
    {
      "key": "warmCoolant",
      "label": "Coolant is warm at",
      "type": "number",
      "unit": "°C",
      "default": 80,
      "steps": [
        60,
        70,
        75,
        80,
        85,
        90
      ]
    }
  ],
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineTemperature": "rs",
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s"
    }
  }
}

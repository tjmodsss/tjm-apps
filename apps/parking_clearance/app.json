{
  "id": "parking_clearance",
  "title": "TJM Parking & Clearance",
  "description": "Read-only PDC distances, steering path and suspension stance for close parking",
  "version": "0.1.8",
  "vendor": "TJM",
  "loggingId": "OB0C",
  "iconGlyph": "P",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_instances": "1",
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_instances": "1",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.chassis.SteeringAngle": {
      "_optional": "live steering path; PDC distances and suspension stance remain available",
      "ActualSteeringAngleDriver": "s",
      "actualSteeringAngleDriverNoCRC": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "TJM Parking & Clearance",
      "buttons": [
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_REFRESH",
          "Refresh"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "vehicleLength",
      "label": "G12 vehicle length",
      "type": "number",
      "unit": "cm",
      "default": 526,
      "steps": [
        526
      ]
    },
    {
      "key": "wheelbase",
      "label": "G12 wheelbase",
      "type": "number",
      "unit": "cm",
      "default": 321,
      "steps": [
        321
      ]
    },
    {
      "key": "warnDistance",
      "label": "Amber distance",
      "type": "number",
      "unit": "cm",
      "default": 70,
      "steps": [
        40,
        50,
        60,
        70,
        80,
        100
      ]
    },
    {
      "key": "criticalDistance",
      "label": "Red distance",
      "type": "number",
      "unit": "cm",
      "default": 35,
      "steps": [
        20,
        25,
        30,
        35,
        40,
        45
      ]
    },
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "Never"
        ],
        [
          "on",
          "Always"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "reset": 2,
      "options": [
        [
          "full",
          "Full screen"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "reset": 2,
      "options": [
        [
          "auto",
          "GPU 60 fps"
        ]
      ]
    }
  ],
  "config": {
    "fullScreenRequired": true
  }
}

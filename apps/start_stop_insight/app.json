{
  "id": "start_stop_insight",
  "title": "TJM Start/Stop Insight",
  "description": "Current and last ten observed Start/Stop inhibition states plus live electrical consumers",
  "version": "0.1.3",
  "vendor": "TJM",
  "loggingId": "OB0D",
  "iconGlyph": "A↻",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineTemperature": "rs",
      "statusEngineStatus": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "TJM Start/Stop Insight",
      "settingsTab": false,
      "buttons": [
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_ACTION",
          "Refresh"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "off",
      "reset": 1,
      "options": [
        [
          "off",
          "Never"
        ],
        [
          "on",
          "Always"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "reset": 2,
      "options": [
        [
          "full",
          "Full screen"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "reset": 2,
      "options": [
        [
          "auto",
          "GPU 60 fps"
        ]
      ]
    }
  ],
  "config": {
    "ddeAddress": 18,
    "readOnly": true,
    "fullScreenRequired": true
  }
}

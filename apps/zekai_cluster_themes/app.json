{
  "id": "zekai_cluster_themes",
  "title": "TJM Instrument Themes",
  "vendor": "TJM",
  "version": "0.8.25",
  "loggingId": "OB34",
  "description": "Persistent, auto-starting instrument themes for BMW iDrive 7. Choose a theme in the app; select BMW original to turn the overlay off.",
  "autostart": true,
  "internet": true,
  "iconGlyph": "gauge",
  "mguHmi": [
    "ID7"
  ],
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "TJM Instrument Themes",
      "buttons": [
        [
          "BTN_SETTINGS",
          "Customize"
        ],
        [
          "BTN_APPLY",
          "Enable selected theme"
        ],
        [
          "BTN_RESTORE",
          "BMW original"
        ]
      ]
    }
  ],
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs",
      "statusBattery2": "rs"
    },
    "de.bmw.infotainment.KombiIF": {
      "statusRangeTankStatus": "rs",
      "statusBordcomputerAverage": "rs",
      "statusBordcomputerTravelData": "rs",
      "_optional": "Fuel range, odometer and trip economy"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "statusNewCurrentUnitsStatusExt": "rs",
      "_optional": "Tyre pressure unit"
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "statusTyrePressure": "rs",
      "_optional": "Tyre pressures"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s",
      "_optional": "Outside temperature"
    },
    "de.bmw.body.Light": {
      "StatusFunctionsIndicators": "s",
      "StatusFunctionsIndicators2": "s",
      "_optional": "VW 2000 turn indicator"
    },
    "de.bmw.infotainment.hmi.hmimediastate.HmiMediaState": {
      "_instances": "HMI_CID",
      "playerMetadata": "rs",
      "coverArt": "rs",
      "_optional": "Front-seat Now playing title and artist"
    },
    "de.bmw.infotainment.entertainment.mediaplayer.MediaPlayer": {
      "_instances": "CarPlayMedia",
      "currentItemMetadata": "rs",
      "playerState": "rs",
      "_optional": "Apple CarPlay Now playing"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ],
      "_optional": "Read-only 12 V and engine oil readings"
    }
  },

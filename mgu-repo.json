{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "mguHmi": [
      "ID7"
    ],
    "requires": {
      "idrive7-renderd": "2.1.7",
      "mgu-inputgate": "1.0.0"
    },
    "build": {
      "python": "kit/tools/build.py",
      "args": [
        "{id}"
      ],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "network": [
        "doom"
      ],
      "shared": [
        "kit/runtime",
        "kit/platform",
        "kit/localization",
        "kit/tools/build.py",
        "kit/tools/pack_data.py",
        "kit/tools/localize.py",
        "kit/tools/locale-revisions.json",
        "kit/tools/oapgen",
        "oap-sdk"
      ]
    }
  },
  "tools": [
    {
      "id": "idrive7-renderd",
      "path": "kit/renderd/prebuilt",
      "title": "GPU renderer",
      "description": "The apps' own GPU renderer (mgu-render): draws them at 60 fps, beside the MGU Store's Renderer; installed with the apps",
      "mguHmi": [
        "ID7"
      ]
    },
    {
      "id": "mgu-inputgate",
      "path": "kit/renderd/prebuilt",
      "version": "1.0.0",
      "title": "Controller gate",
      "description": "Lets the apps have the iDrive controller (tabs, page buttons, settings, Doom); loads into the HMI at the next start",
      "needs": [
        "renderer"
      ],
      "optional": false,
      "mguHmi": [
        "ID7"
      ],
      "preload": {
        "library": "mgu-inputgate.so",
        "unit": "hmi.service",
        "process": "HmiMain3D",
        "strikes": 2,
        "checkAfterSeconds": 120,
        "healthySeconds": 60
      }
    },
    {
      "id": "front-camera-cluster-helper",
      "path": "third_party/store-tools/front-camera-cluster"
    },
    {
      "id": "hotspot-studio-helper",
      "path": "third_party/store-tools/hotspot-studio-helper"
    },
    {
      "id": "vehicle-network-observer",
      "path": "third_party/store-tools/vehicle-network-observer"
    }
  ]
}

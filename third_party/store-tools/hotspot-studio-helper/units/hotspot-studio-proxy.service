[Unit]
Description=Userspace Internet and ENET proxy for the BMW hotspot
After=network.target mgu-uplink.service hotspot-studio-helper.service
Wants=mgu-uplink.service hotspot-studio-helper.service

[Service]
Type=simple
User=nobody
Group=tm_oap_app
ExecStart=/var/opt/mgu-python/current/bin/python3 /var/opt/hotspot-studio-helper/current/hotspot_studio_proxy.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
